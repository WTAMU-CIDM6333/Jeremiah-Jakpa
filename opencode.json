{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mentalysis",
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "deny",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow"
    },
    "mcp__flights__add_flight": "ask",
    "add_flight": "ask"
  },
  "mcp": {
    "flights": {
      "type": "local",
      "command": [
        "python",
        "evolution-04/lab/flights_mcp_server.py"
      ],
      "enabled": true
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "llama3.2:3b": {
          "name": "Llama 3.2 3B (local)"
        }
      }
    }
  }
}
